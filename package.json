{
  "name": "opn-browser",
  "version": "1.0.0",
  "description": "A custom Chromium-based browser for macOS",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --mac",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --mac --dir"
  },
  "keywords": [
    "browser",
    "chromium",
    "electron",
    "macos"
  ],
  "author": "opn-browser",
  "license": "MIT",
  "build": {
    "appId": "com.opn.browser",
    "productName": "OPN Browser",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^39.1.2",
    "electron-builder": "^24.9.1"
  }
}
